{
  "entry": "server.js",
  "port": { "file": "config.json", "key": "port" },
  "ready": { "method": "GET", "path": "/api/board" },
  "steps": [
    { "name": "create",
      "request": { "method": "POST", "path": "/api/tasks", "body": { "text": "probe: created", "groupId": "inbox" } },
      "expect": [ { "path": "status", "eq": 200 } ],
      "pick": { "taskId": { "from": "body.board.tasks", "where": { "text": "probe: created" }, "field": "id" } } },
    { "name": "drag",
      "request": { "method": "POST", "path": "/api/tasks/{taskId}/move", "body": { "groupId": "now", "index": 0 } },
      "expect": [ { "path": "status", "eq": 200 }, { "from": "body.board.tasks", "where": { "id": "{taskId}" }, "field": "groupId", "eq": "now" } ] },
    { "name": "edit",
      "request": { "method": "PATCH", "path": "/api/tasks/{taskId}", "body": { "text": "probe: edited" } },
      "expect": [ { "path": "status", "eq": 200 }, { "from": "body.board.tasks", "where": { "id": "{taskId}" }, "field": "text", "eq": "probe: edited" } ] },
    { "name": "done",
      "request": { "method": "PATCH", "path": "/api/tasks/{taskId}", "body": { "done": true } },
      "expect": [ { "path": "status", "eq": 200 }, { "from": "body.board.tasks", "where": { "id": "{taskId}" }, "field": "done", "eq": true } ] },
    { "name": "job",
      "request": { "method": "POST", "path": "/api/jobs", "body": { "title": "probe job" } },
      "expect": [ { "path": "status", "eq": 200 } ],
      "pick": { "jobId": { "from": "body.board.jobs", "where": { "title": "probe job" }, "field": "id" } } },
    { "name": "add-to-job",
      "request": { "method": "POST", "path": "/api/jobs/{jobId}/tasks", "body": { "taskId": "{taskId}" } },
      "expect": [ { "path": "status", "eq": 200 }, { "from": "body.board.jobs", "where": { "id": "{jobId}" }, "field": "taskIds", "contains": "{taskId}" } ] },
    { "name": "export",
      "request": { "method": "GET", "path": "/api/jobs/{jobId}/export" },
      "expect": [ { "path": "status", "eq": 200 },
                  { "path": "body.fenced", "contains": "probe: edited" },
                  { "path": "body.fenced", "matches": "^(`{3,})[^\\n]*\\n[\\s\\S]*\\n\\1\\s*$" } ] },
    { "name": "restart", "restart": true },
    { "name": "read-back",
      "request": { "method": "GET", "path": "/api/board" },
      "expect": [ { "from": "body.board.tasks", "where": { "id": "{taskId}" }, "field": "text", "eq": "probe: edited" },
                  { "from": "body.board.tasks", "where": { "id": "{taskId}" }, "field": "done", "eq": true },
                  { "from": "body.board.tasks", "where": { "id": "{taskId}" }, "field": "groupId", "eq": "now" },
                  { "from": "body.board.jobs", "where": { "id": "{jobId}" }, "field": "taskIds", "contains": "{taskId}" } ] },
    { "name": "pull",
      "request": { "method": "POST", "path": "/api/pull" },
      "expect": [ { "path": "status", "eq": 200 } ] },
    { "name": "pull-title",
      "request": { "method": "GET", "path": "/api/board" },
      "expect": [ { "from": "body.board.tasks", "where": { "source.kind": "session" }, "count_min": 1 },
                  { "from": "body.board.tasks", "where": { "source.kind": "session" }, "field": "text", "oracle": "session-titles" } ] }
  ]
}
